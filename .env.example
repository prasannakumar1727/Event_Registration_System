# Copy to .env (cp .env.example .env). Never commit the real .env file.
# SECRET_KEY: leave as-is to auto-generate a random key in instance/secret_key.txt,
# or set your own long random value.
SECRET_KEY=change-me
DATABASE_PATH=database/events.db
ORGANIZER_USERNAME=organizer
ORGANIZER_PASSWORD=Organizer@123
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
# Set to 1 when serving over HTTPS
SESSION_COOKIE_SECURE=0
# Optional real email confirmations (leave SMTP_HOST empty to log them to the console instead)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=events@example.com
